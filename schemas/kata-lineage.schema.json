{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kata-lineage.schema.json",
  "title": "ZEROSHIKI KataLineage v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "lineage_id",
    "kata_ref",
    "root_kata_refs",
    "parent_kata_refs",
    "generation",
    "derivation_type",
    "inherited_step_ids",
    "introduced_step_ids",
    "created_at"
  ],
  "$defs": {
    "kata_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kata_id",
        "version"
      ],
      "properties": {
        "kata_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "record_type": {
      "const": "kata_lineage"
    },
    "lineage_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "kata_ref": {
      "$ref": "#/$defs/kata_ref"
    },
    "root_kata_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/kata_ref"
      }
    },
    "parent_kata_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/kata_ref"
      }
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "derivation_type": {
      "type": "string",
      "enum": [
        "root",
        "refinement",
        "specialization",
        "generalization",
        "composition",
        "fork"
      ]
    },
    "inherited_step_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "introduced_step_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "derivation_reason": {
      "type": "string",
      "maxLength": 1600
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
