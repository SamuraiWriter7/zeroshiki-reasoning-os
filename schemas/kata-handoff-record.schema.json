{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kata-handoff-record.schema.json",
  "title": "ZEROSHIKI KataHandoffRecord v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "handoff_id",
    "plan_id",
    "from_stage_id",
    "to_stage_id",
    "from_kata_id",
    "to_kata_id",
    "payload_summary",
    "provided_fields",
    "required_fields",
    "validation_status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.4.0"
    },
    "record_type": {
      "const": "kata_handoff_record"
    },
    "handoff_id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "from_stage_id": {
      "type": "string"
    },
    "to_stage_id": {
      "type": "string"
    },
    "from_kata_id": {
      "type": "string"
    },
    "to_kata_id": {
      "type": "string"
    },
    "payload_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "provided_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "required_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
