{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kata-evolution-record.schema.json",
  "title": "ZEROSHIKI KataEvolutionRecord v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "evolution_id",
    "kata_id",
    "from_version",
    "to_version",
    "reason",
    "evidence_trace_ids",
    "causal_validation_ids",
    "applicability_assessment_ids",
    "changed_steps",
    "reversible",
    "rollback_target_version",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "record_type": {
      "const": "kata_evolution_record"
    },
    "evolution_id": {
      "type": "string"
    },
    "kata_id": {
      "type": "string"
    },
    "from_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "to_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "reason": {
      "type": "string",
      "enum": [
        "repeated_success",
        "causal_validation",
        "failure_boundary_update",
        "applicability_update",
        "pruning",
        "manual_revision"
      ]
    },
    "evidence_trace_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "causal_validation_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "applicability_assessment_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "changed_steps": {
      "type": "object",
      "required": [
        "added",
        "modified",
        "removed"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "reversible": {
      "const": true
    },
    "rollback_target_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
