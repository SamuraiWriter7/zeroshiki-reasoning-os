{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kata-orchestration-plan.schema.json",
  "title": "ZEROSHIKI KataOrchestrationPlan v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "plan_id",
    "selection_decision_id",
    "source_composition_id",
    "execution_strategy",
    "stages",
    "conflict_policy",
    "fallback_policy",
    "created_at"
  ],
  "$defs": {
    "kata_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kata_id",
        "version"
      ],
      "properties": {
        "kata_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "0.4.0"
    },
    "record_type": {
      "const": "kata_orchestration_plan"
    },
    "plan_id": {
      "type": "string"
    },
    "selection_decision_id": {
      "type": "string"
    },
    "source_composition_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_strategy": {
      "type": "string",
      "enum": [
        "sequential",
        "parallel",
        "gated",
        "hybrid"
      ]
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage_id",
          "kata_ref",
          "order",
          "depends_on",
          "input_contract",
          "output_contract",
          "on_failure"
        ],
        "properties": {
          "stage_id": {
            "type": "string"
          },
          "kata_ref": {
            "$ref": "#/$defs/kata_ref"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "input_contract": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "output_contract": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "on_failure": {
            "type": "string",
            "enum": [
              "abort",
              "skip",
              "escalate_to_deep",
              "fallback"
            ]
          }
        }
      }
    },
    "conflict_policy": {
      "type": "string",
      "enum": [
        "reject",
        "escalate_to_deep",
        "prefer_higher_maturity",
        "manual_review"
      ]
    },
    "fallback_policy": {
      "type": "string",
      "enum": [
        "degrade_gracefully",
        "escalate_to_deep",
        "fail_closed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
