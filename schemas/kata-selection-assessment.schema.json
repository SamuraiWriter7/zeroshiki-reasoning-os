{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kata-selection-assessment.schema.json",
  "title": "ZEROSHIKI KataSelectionAssessment v0.4",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "record_type",
    "selection_id",
    "input_summary",
    "strategy",
    "candidates",
    "selected_kata_refs",
    "decision",
    "decision_rationale",
    "created_at"
  ],

  "$defs": {
    "kata_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kata_id",
        "version"
      ],
      "properties": {
        "kata_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    }
  },

  "properties": {
    "schema_version": {
      "const": "0.4.0"
    },

    "record_type": {
      "const": "kata_selection_assessment"
    },

    "selection_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },

    "input_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },

    "strategy": {
      "type": "string",
      "enum": [
        "best_fit",
        "highest_maturity",
        "lowest_cost",
        "balanced",
        "policy_driven"
      ]
    },

    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,

        "required": [
          "kata_ref",
          "applicability_assessment_id",
          "intent_match_score",
          "maturity_level",
          "compute_cost_class",
          "priority_score",
          "selected"
        ],

        "properties": {
          "kata_ref": {
            "$ref": "#/$defs/kata_ref"
          },

          "applicability_assessment_id": {
            "type": "string"
          },

          "intent_match_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },

          "maturity_level": {
            "type": "string",
            "enum": [
              "K0",
              "K1",
              "K2",
              "K3",
              "K4",
              "K5"
            ]
          },

          "compute_cost_class": {
            "type": "string",
            "enum": [
              "minimal",
              "bounded",
              "extended"
            ]
          },

          "priority_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },

          "selected": {
            "type": "boolean"
          },

          "rejection_reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        }
      }
    },

    "selected_kata_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/kata_ref"
      }
    },

    "decision": {
      "type": "string",
      "enum": [
        "single_kata",
        "multi_kata",
        "escalate_deep",
        "reject"
      ]
    },

    "decision_rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1600
    },

    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
