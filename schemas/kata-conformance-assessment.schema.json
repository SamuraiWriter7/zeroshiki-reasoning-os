{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kata-conformance-assessment.schema.json",
  "title": "ZEROSHIKI KataConformanceAssessment v0.5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "assessment_id",
    "kata_ref",
    "profile_id",
    "interface_id",
    "checks",
    "evidence_trace_ids",
    "result",
    "created_at"
  ],
  "$defs": {
    "kata_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kata_id",
        "version"
      ],
      "properties": {
        "kata_id": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "0.5.0"
    },
    "record_type": {
      "const": "kata_conformance_assessment"
    },
    "assessment_id": {
      "type": "string"
    },
    "kata_ref": {
      "$ref": "#/$defs/kata_ref"
    },
    "profile_id": {
      "type": "string"
    },
    "interface_id": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "status",
          "evidence_ids"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "enum": [
              "schema",
              "semantic",
              "trace",
              "applicability",
              "lineage",
              "maturity",
              "orchestration",
              "interface"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "not_applicable"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence_trace_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "result": {
      "type": "string",
      "enum": [
        "conformant",
        "non_conformant"
      ]
    },
    "notes": {
      "type": "string",
      "maxLength": 1600
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
