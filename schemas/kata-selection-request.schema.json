{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kata-selection-request.schema.json",
  "title": "ZEROSHIKI KataSelectionRequest v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "request_id",
    "input_summary",
    "candidate_kata_refs",
    "objective",
    "constraints",
    "created_at"
  ],
  "$defs": {
    "kata_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kata_id",
        "version"
      ],
      "properties": {
        "kata_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "0.4.0"
    },
    "record_type": {
      "const": "kata_selection_request"
    },
    "request_id": {
      "type": "string"
    },
    "input_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "candidate_kata_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/kata_ref"
      }
    },
    "objective": {
      "type": "string",
      "enum": [
        "accuracy",
        "latency",
        "compute_efficiency",
        "safety",
        "balanced"
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_selected_katas",
        "maximum_compute_level"
      ],
      "properties": {
        "max_selected_katas": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_maturity_level": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "K0",
            "K1",
            "K2",
            "K3",
            "K4",
            "K5",
            null
          ]
        },
        "maximum_compute_level": {
          "type": "string",
          "enum": [
            "rest",
            "kata",
            "deep"
          ]
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
