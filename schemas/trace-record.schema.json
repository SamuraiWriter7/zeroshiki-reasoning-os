{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trace-record.schema.json",
  "title": "ZEROSHIKI TraceRecord v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "trace_id",
    "input_summary",
    "execution_mode",
    "applied_kata_id",
    "applicability_assessment_id",
    "breathing_profile_id",
    "execution_steps",
    "outcome_summary",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "record_type": {
      "const": "trace_record"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "parent_trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "direct",
        "kata",
        "deep"
      ]
    },
    "applied_kata_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "applicability_assessment_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "breathing_profile_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "action",
          "input_summary",
          "output_summary",
          "validation_result"
        ],
        "properties": {
          "step_id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "input_summary": {
            "type": "string"
          },
          "output_summary": {
            "type": "string"
          },
          "validation_result": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "not_checked"
            ]
          }
        }
      }
    },
    "outcome_summary": {
      "type": "string",
      "minLength": 1
    },
    "resource_metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "latency_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_outcome": {
          "type": "string",
          "enum": [
            "hit",
            "miss",
            "not_applicable",
            "unknown"
          ]
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
