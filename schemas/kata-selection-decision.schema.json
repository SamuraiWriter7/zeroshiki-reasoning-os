{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kata-selection-decision.schema.json",
  "title": "ZEROSHIKI KataSelectionDecision v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "decision_id",
    "request_id",
    "candidate_evaluations",
    "decision",
    "selected_kata_refs",
    "selected_breathing_level",
    "reason",
    "created_at"
  ],
  "$defs": {
    "kata_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kata_id",
        "version"
      ],
      "properties": {
        "kata_id": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "0.4.0"
    },
    "record_type": {
      "const": "kata_selection_decision"
    },
    "decision_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "candidate_evaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kata_ref",
          "eligible",
          "boundary_blocked",
          "applicability_assessment_id",
          "maturity_assessment_id",
          "rank",
          "exclusion_reason"
        ],
        "properties": {
          "kata_ref": {
            "$ref": "#/$defs/kata_ref"
          },
          "eligible": {
            "type": "boolean"
          },
          "boundary_blocked": {
            "type": "boolean"
          },
          "applicability_assessment_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "maturity_assessment_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "rank": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "exclusion_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "single",
        "composed",
        "escalate",
        "reject"
      ]
    },
    "selected_kata_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/kata_ref"
      }
    },
    "selected_breathing_level": {
      "type": "string",
      "enum": [
        "kata",
        "deep",
        "none"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1600
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
